PORT=5000
NODE_ENV=development
JWT_SECRET=fyp_patient_app_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patient_app_db

# ============================================================
# AI PROVIDER ARCHITECTURE
# ============================================================
# Choose active AI provider: 'local' (default rule engine) | 'openai' | 'gemini'
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================================
# MAP & ROUTING PROVIDER ARCHITECTURE
# ============================================================
# Choose active providers:
# MAP_PROVIDER: 'maplibre' (default) | 'google'
# ROUTING_PROVIDER: 'openrouteservice' (default) | 'geoapify' | 'google'
# PLACES_PROVIDER: 'geoapify' (default) | 'google'
MAP_PROVIDER=maplibre
ROUTING_PROVIDER=openrouteservice
PLACES_PROVIDER=geoapify

# Open Providers (Free Tiers available at geoapify.com & openrouteservice.org)
